set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Abort a stuck bootstrap: start a spare joining, kill it mid-bootstrap, then nodetool-abortbootstrap
# it, committing CANCEL_SEQUENCE + Unregister. Exercises the rollback path (locks released, placement
# reverted) that the b-* range-movement safety invariants then check; the "an in-progress sequence
# was cancelled" reachability assertion is SUT-side in LocalLog. The spare is recycled afterwards.
#
# serial_driver: reads cluster-wide state to pick a safe spare and must not race another copy of
# itself into aborting two bootstraps at once.
exec "$HERE/helper_run.sh" abort-sequence
