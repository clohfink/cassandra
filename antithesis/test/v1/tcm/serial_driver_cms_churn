HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# One random CMS operation: reconfigure, snapshot, resume, cancel, cancel a sequence, or pause
# commits briefly.
#
# Drives r-cms-reconfiguration-observed, which guards the two CMS safety properties -- both are
# AlwaysOrUnreachable and pass vacuously if reconfiguration never runs. Snapshots also make
# r-snapshot-catchup-used reachable: a lagging node can only be served a snapshot if one exists.
exec "$HERE/helper_run.sh" cms-churn
