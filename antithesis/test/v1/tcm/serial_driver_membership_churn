set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# One random membership operation: join a spare, decommission, move, restart, stop, or
# wipe-and-rejoin. Fire-and-forget, so the next operation can start while this sequence is still in
# flight -- that overlap is what makes r-concurrent-multistep-operations reachable.
#
# serial_driver rather than parallel_driver: the *selection* logic reads cluster-wide state
# (how many nodes are joined) and must not race another copy of itself into violating the
# never-drop-below-RF policy. The operations it launches still overlap, because they are
# asynchronous.
exec "$HERE/helper_run.sh" membership-churn
