set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Quiet-period checks. Antithesis stops all faults and restores killed containers before running an
# eventually_ command, which is the only clean way to tell "still catching up" from "permanently
# divergent".
#
# In order: clear workload-induced impediments and restart anything the workload stopped, then
# check convergence, sequence drain, and that the CMS still accepts a commit.
#
# The restart-first step is what makes b-sequence-resumable-after-crash sound: CEP-21 forbids
# failure detection from cancelling a sequence, so a sequence owned by a node the workload killed and
# never restarted is *correctly* stuck. Asserting it drains without restarting first would assert
# the opposite of the design.
exec "$HERE/helper_run.sh" check-recovery \
  "${RECOVERY_CONVERGE_MILLIS:-600000}" \
  "${RECOVERY_DRAIN_MILLIS:-600000}" \
  "${RECOVERY_COMMIT_MILLIS:-300000}"
