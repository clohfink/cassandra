# d-prepared-statement-not-stale: prepare, ALTER, wait for the node's own epoch to pass the change,
# then re-execute on the same pinned session.
#
# Regression target for CASSANDRA-20116 (9bf1680b1f) and the two related invalidation fixes. One of
# only two properties in the catalog that observes a client-visible wrong answer.
exec "$HERE/helper_run.sh" prepared-check
