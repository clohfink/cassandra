set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Replace-same-address on one ring node: stop it, wait for peers to mark it down, then re-bootstrap
# it taking over its own previous ring position (the disk-loss-rebuild scenario). This drives the
# replace multi-step operation (PREPARE/START/MID/FINISH_REPLACE) that no other driver exercises;
# the "a node completed a replacement" reachability assertion is SUT-side in LocalLog.
#
# serial_driver, not parallel: it reads cluster-wide state to pick a safe victim (more than RF nodes
# NORMAL, non-seed) and must not race another copy of itself into taking two nodes down at once.
exec "$HERE/helper_run.sh" replace-node
