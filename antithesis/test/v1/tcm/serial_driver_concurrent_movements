set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Launches a BURST of 2+ range movements (joins on spares and/or moves to independent random tokens)
# fire-and-forget, then samples tightly to confirm they overlapped in flight. This is what makes
# r-concurrent-multistep-operations fire, which in turn makes the concurrency-admission safety
# properties (b-no-overlapping-locked-ranges, b-locked-ranges-match-sequences) non-vacuous.
#
# serial_driver: the selection reads cluster-wide state and must not race another copy of itself
# into picking the same target; the operations it launches still overlap because they are async.
exec "$HERE/helper_run.sh" concurrent-movements
