set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Commits uniquely-tagged DDL. This is the metadata-commit workhorse: it drives epoch advancement so
# nodes have something to disagree about, and it feeds the tag ledger that
# c-commit-survives-cms-membership-change checks for exactly-once semantics.
#
# parallel_driver: several copies may run at once, which is wanted -- concurrent DDL from different
# coordinators is what makes d-schema-agreement-at-same-epoch interesting.
exec "$HERE/helper_run.sh" schema-churn "${SCHEMA_CHURN_OPS:-3}"
