<!--
  Logback configuration for in-JVM Cassandra nodes started by the jvm-dtest framework
  (org.apache.cassandra.distributed). Each Cassandra instance inside the test JVM uses
  this config to control its own logging. Keep this at WARN to avoid flooding test
  output with Cassandra startup noise; lower to DEBUG when diagnosing cluster issues.
-->
<configuration debug="false">
  <define name="cluster_id" class="org.apache.cassandra.distributed.impl.ClusterIDDefiner" />
  <define name="instance_id" class="org.apache.cassandra.distributed.impl.InstanceIDDefiner" />

  <appender name="STDOUT" target="System.out" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level [%thread] ${instance_id} %date{HH:mm:ss,SSS} %msg%n</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
  </appender>

  <logger name="org.apache.cassandra" level="WARN"/>
  <logger name="org.apache.cassandra.distributed" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
